ANTHROPIC_API_KEY=
# Agent ID/version and environment ID are derived from cma/claude-lock.json.
# Private A2A controller endpoint for the application control plane.
CMA_A2A_ENDPOINT=
A2A_EVENT_SINK_URL=
# Exact callback URL the controller may use for push delivery.
CMA_A2A_PUSH_ALLOWED_URL=
# Durable CMA task and A2A push wakeup queues. Leave unset for local workers.
CMA_SCHEDULER_QUEUE_URL=
CMA_PUSH_QUEUE_URL=
ANTHROPIC_WEBHOOK_SIGNING_KEY=

SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
# Local developer-only user token for `npm run e2e:slack-user`; never deployed or synced.
SLACK_USER_TOKEN=
# Optional exact bot/app pair allowed through deployed ingress for local user smoke.
SLACK_USER_BOT_ID=
SLACK_USER_APP_ID=
# Sandbox channel for the opt-in real-Slack-user smoke.
E2E_LIVE_SLACK_CHANNEL_ID=
# Optional team assertion for the real-Slack-user smoke.
E2E_LIVE_SLACK_TEAM_ID=
# Optional development allowlist only. Identity and authorization come from DSQL.
SLACK_TEAM_ID=
SLACK_USER_ID=
# Set after the first Terraform apply to enable URL-dependent Slack features.
PUBLIC_APP_URL=
SLACK_BOUND_THREAD_REPLIES=false
SLACK_AGENT_VIEW_ENABLED=false
SLACK_STREAMING_ENABLED=false
SLACK_TOOL_APPROVALS_ENABLED=false
SLACK_FEEDBACK_ENABLED=false
SLACK_SHORTCUTS_ENABLED=false
SLACK_ACTIVE_CONTEXT_ENABLED=false
SLACK_UNFURLS_ENABLED=false
SLACK_RECEIPT_REACTION_ENABLED=false
SLACK_RECEIPT_REACTION=eyes
SLACK_SOURCE_LINKS_ENABLED=false
SLACK_TASK_CARDS_ENABLED=false

WEB_ACCESS_TOKEN=
WEB_COOKIE_SECRET=

AWS_PROFILE=default
AWS_REGION=us-west-2
# Optional guard: refuse deployment unless STS reports this account ID.
EXPECTED_AWS_ACCOUNT_ID=
# Optional override for an existing or shared remote-state bucket.
TF_STATE_BUCKET=
APP_NAME=claude-managed-agents-ui-eda
DEPLOYMENT_ENVIRONMENT=dev
DSQL_ENDPOINT=
DSQL_DATABASE=postgres
DSQL_ROLE=app_runtime
EVENT_BUS_NAME=claude-managed-agents-ui-eda-dev

# Local E2E uses scripts/e2e.sh, which supplies synthetic config without reading .env.
# DATABASE_MODE defaults to dsql; postgres requires DATABASE_URL.
# APP_ENV=e2e exposes test controls only through managed_agents_app.local_api.
